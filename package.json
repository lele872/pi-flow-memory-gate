{
  "name": "pi-flow-memory-gate",
  "version": "0.1.0",
  "description": "Memory gate for Pi: a local decision model decides what is worth remembering, you approve. Additive to pi-hermes-memory.",
  "type": "module",
  "main": "src/index.ts",
  "keywords": [
    "pi-package",
    "pi-extension",
    "memory",
    "decision-model",
    "agent-memory"
  ],
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "files": [
    "src",
    "gate-questions.json",
    "consolidate-questions.json",
    "consolidate-pair-questions.json",
    "trigger-patterns.json",
    "gate-synth-prompt.txt",
    "README.md",
    "README.it.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "check": "tsc --noEmit && eslint src/"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "jiti": "^2.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "license": "MIT"
}

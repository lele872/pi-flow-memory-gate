DECISION_MODEL_URL=http://127.0.0.1:8017
DECISION_MODEL_ID=rizzo-latest
GATE_INTERVAL=10
GATE_WINDOW=20
GATE_QUESTIONS_PATH=
GATE_SECRET_THRESHOLD=0.5
GATE_SESSION_THRESHOLD=0.8
GATE_DURABLE_THRESHOLD=0.5
GATE_FAILURE_THRESHOLD=0.5
GATE_IMPORTANCE_THRESHOLD=2.5
GATE_MAX_QUEUE=20
GATE_REVIEW_MODE=confirm      # confirm | auto | off
GATE_TRIGGER=always           # always | interval | patterns
GATE_PATTERNS_PATH=           # trigger-patterns.json for patterns mode
GATE_IMPORTANCE_MIN=1.5       # min importance when durable alone qualifies
GATE_SYNTHESIZE=true          # LLM rewrite of approved candidates (false = raw text)
GATE_MEMORY_DIR=              # default ~/.pi/agent/memory-gate
GATE_SYNTH_PROMPT_PATH=       # custom synthesis prompt file (placeholders: {target}, {state})
GATE_RELEVANT_THRESHOLD=0.5
GATE_SAME_FACT_THRESHOLD=0.55
GATE_HARD_DROP_THRESHOLD=0.7
GATE_PAIR_JACCARD_MIN=0.3
GATE_CONSOLIDATE_QUESTIONS_PATH=
GATE_PAIR_QUESTIONS_PATH=
GATE_CALIB_THRESHOLD=200      # rows before the calibration-ready notification
GATE_TUI_LOG=widget           # widget | notify | off — how gate logs render in the TUI
